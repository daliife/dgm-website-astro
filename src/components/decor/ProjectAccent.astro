---
import type { ProjectAccentPattern } from "../../types/ui";

interface Props {
  pattern?: ProjectAccentPattern;
  idSuffix: string;
}

const { pattern = "default", idSuffix } = Astro.props;
const pid = `project-accent-${idSuffix}`;
---

<div
  class="pointer-events-none absolute -inset-x-6 -top-24 bottom-0 max-h-72 overflow-hidden opacity-90 print:hidden"
  aria-hidden="true"
>
  <svg
    class="h-full w-full text-text-muted opacity-[0.11] dark:opacity-[0.08]"
    viewBox="0 0 800 280"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    {
      pattern === "default" && (
        <>
          <defs>
            <pattern
              id={`${pid}-dots`}
              width="20"
              height="20"
              patternUnits="userSpaceOnUse"
            >
              <circle cx="1" cy="1" r="0.6" fill="currentColor" />
            </pattern>
          </defs>
          <rect width="800" height="280" fill={`url(#${pid}-dots)`} />
        </>
      )
    }
    {
      pattern === "grid" && (
        <>
          <defs>
            <pattern
              id={`${pid}-grid`}
              width="32"
              height="32"
              patternUnits="userSpaceOnUse"
            >
              <path
                d="M 32 0 L 0 0 0 32"
                fill="none"
                stroke="currentColor"
                stroke-width="0.5"
              />
            </pattern>
          </defs>
          <rect width="800" height="280" fill={`url(#${pid}-grid)`} />
        </>
      )
    }
    {
      pattern === "orbit" && (
        <>
          <circle
            cx="620"
            cy="140"
            r="120"
            fill="none"
            stroke="currentColor"
            stroke-width="0.75"
          />
          <circle
            cx="620"
            cy="140"
            r="80"
            fill="none"
            stroke="currentColor"
            stroke-width="0.75"
          />
          <circle
            cx="620"
            cy="140"
            r="40"
            fill="none"
            stroke="currentColor"
            stroke-width="0.75"
          />
          <circle cx="740" cy="140" r="4" fill="currentColor" />
        </>
      )
    }
    {
      pattern === "wave" && (
        <>
          <path
            d="M0 180 C120 120 240 240 360 180 S600 120 800 180"
            fill="none"
            stroke="currentColor"
            stroke-width="0.75"
          />
          <path
            d="M0 210 C120 150 240 270 360 210 S600 150 800 210"
            fill="none"
            stroke="currentColor"
            stroke-width="0.5"
            opacity="0.7"
          />
        </>
      )
    }
    {
      pattern === "lcars" && (
        <>
          <rect
            x="0"
            y="48"
            width="520"
            height="28"
            rx="14"
            fill="currentColor"
          />
          <rect
            x="540"
            y="48"
            width="160"
            height="28"
            rx="14"
            fill="currentColor"
            opacity="0.55"
          />
          <rect
            x="0"
            y="96"
            width="320"
            height="22"
            rx="11"
            fill="currentColor"
            opacity="0.35"
          />
          <rect
            x="340"
            y="96"
            width="460"
            height="22"
            rx="11"
            fill="currentColor"
            opacity="0.2"
          />
        </>
      )
    }
    {
      pattern === "circuit" && (
        <>
          <path
            d="M40 200 H200 V120 H360 V200 H520"
            fill="none"
            stroke="currentColor"
            stroke-width="0.75"
          />
          <circle cx="40" cy="200" r="5" fill="currentColor" />
          <circle cx="200" cy="120" r="5" fill="currentColor" />
          <circle cx="360" cy="200" r="5" fill="currentColor" />
          <circle cx="520" cy="200" r="5" fill="currentColor" />
        </>
      )
    }
  </svg>
</div>
