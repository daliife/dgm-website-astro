---
/** Site-wide subtle dot grid — fixed behind content. */
---

<div
  class="pointer-events-none fixed inset-0 z-0 overflow-hidden print:hidden"
  aria-hidden="true"
>
  <svg
    class="h-full w-full text-text-muted opacity-[0.14] dark:opacity-[0.09]"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern
        id="editorial-dot-grid"
        width="24"
        height="24"
        patternUnits="userSpaceOnUse"
      >
        <circle cx="1" cy="1" r="0.75" fill="currentColor"></circle>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#editorial-dot-grid)"></rect>
  </svg>
</div>
