---
import type { ButtonVariant, ButtonSize } from "../../types/ui";

interface Props {
  variant?: ButtonVariant;
  size?: ButtonSize;
  href?: string;
  target?: string;
  rel?: string;
  className?: string;
  disabled?: boolean;
  id?: string;
  "aria-label"?: string;
  "aria-pressed"?: "true" | "false";
}

const {
  variant = "primary",
  size = "md",
  href,
  target,
  rel,
  className = "",
  disabled = false,
  id,
  "aria-label": ariaLabel,
  "aria-pressed": ariaPressed,
} = Astro.props;

const baseClasses =
  " inline-flex items-center justify-center gap-3 rounded-none font-medium transition-[color,background-color,border-color,opacity] duration-200 ease-out focus-visible:outline-offset-4 disabled:cursor-not-allowed disabled:opacity-50";

const variantClasses: Record<ButtonVariant, string> = {
  primary: "bg-text-primary text-bg-primary hover:opacity-90",
  outline:
    "border border-border-secondary text-text-primary hover:border-text-primary hover:bg-bg-muted/50",
  ghost: "text-text-secondary hover:bg-bg-muted hover:text-text-primary",
  simple: "rounded-none text-inherit no-underline hover:no-underline",
};

const sizeClasses: Record<ButtonSize, string> = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-2.5 text-base",
  none: "",
};

const buttonClasses = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;

const isLink = href !== undefined;
const Tag = isLink ? "a" : "button";

const commonAttrs: Record<string, unknown> = {};
if (id) commonAttrs.id = id;
if (ariaLabel) commonAttrs["aria-label"] = ariaLabel;
if (ariaPressed) commonAttrs["aria-pressed"] = ariaPressed;

const tagProps = isLink
  ? { href, target, rel, ...commonAttrs }
  : { disabled, ...commonAttrs };
---

<Tag class={buttonClasses} {...tagProps}>
  <slot />
</Tag>
