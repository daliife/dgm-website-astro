---
import type { ButtonVariant, ButtonSize } from "../../types/ui";

interface Props {
  variant?: ButtonVariant;
  size?: ButtonSize;
  href?: string;
  target?: string;
  rel?: string;
  className?: string;
  disabled?: boolean;
  id?: string;
  "aria-label"?: string;
}

const {
  variant = "primary",
  size = "md",
  href,
  target,
  rel,
  className = "",
  disabled = false,
  id,
  "aria-label": ariaLabel,
} = Astro.props;

const baseClasses =
  " inline-flex items-center justify-center gap-3 font-medium transition-all duration-200 ease-out rounded-lg disabled:opacity-50 disabled:cursor-not-allowed";

const variantClasses: Record<ButtonVariant, string> = {
  primary:
    "bg-text-primary text-bg-primary hover:opacity-90 hover:scale-[1.02] active:scale-[0.98]",
  outline:
    "border border-border-secondary text-text-primary hover:border-text-primary hover:bg-bg-muted/50",
  ghost: "text-text-secondary hover:bg-bg-muted hover:text-text-primary",
  simple:
    "text-text-muted hover:text-text-primary underline-offset-4 hover:underline",
};

const sizeClasses: Record<ButtonSize, string> = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-2.5 text-base",
  none: "",
};

const buttonClasses = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;

const isLink = href !== undefined;
const Tag = isLink ? "a" : "button";

const commonAttrs: Record<string, unknown> = {};
if (id) commonAttrs.id = id;
if (ariaLabel) commonAttrs["aria-label"] = ariaLabel;

const tagProps = isLink
  ? { href, target, rel, ...commonAttrs }
  : { disabled, ...commonAttrs };
---

<Tag class={buttonClasses} {...tagProps}>
  <slot />
</Tag>
