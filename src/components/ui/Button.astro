---
import type { ButtonVariant, ButtonSize } from "../../types/ui";

interface Props {
  variant?: ButtonVariant;
  size?: ButtonSize;
  href?: string;
  target?: string;
  rel?: string;
  className?: string;
  disabled?: boolean;
  id?: string;
  "aria-label"?: string;
  /** Drift a few pixels toward the cursor (fine pointers, motion allowed). */
  magnetic?: boolean;
}

const {
  variant = "primary",
  size = "md",
  href,
  target,
  rel,
  className = "",
  disabled = false,
  id,
  "aria-label": ariaLabel,
  magnetic = false,
} = Astro.props;

const baseClasses =
  " inline-flex items-center justify-center gap-3 font-medium transition-all duration-200 ease-out rounded-lg focus-visible:outline-offset-4 disabled:opacity-50 disabled:cursor-not-allowed";

const variantClasses: Record<ButtonVariant, string> = {
  primary:
    "bg-text-primary text-bg-primary hover:opacity-90 hover:scale-[1.02] active:scale-[0.98]",
  outline:
    "border border-border-secondary text-text-primary hover:border-text-primary hover:bg-bg-muted/50",
  ghost: "text-text-secondary hover:bg-bg-muted hover:text-text-primary",
  simple: "rounded-none text-inherit no-underline hover:no-underline",
};

const sizeClasses: Record<ButtonSize, string> = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-2.5 text-base",
  none: "",
};

const buttonClasses = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;

const isLink = href !== undefined;
const Tag = isLink ? "a" : "button";

const commonAttrs: Record<string, unknown> = {};
if (id) commonAttrs.id = id;
if (ariaLabel) commonAttrs["aria-label"] = ariaLabel;
if (magnetic) commonAttrs["data-magnetic"] = "";

const tagProps = isLink
  ? { href, target, rel, ...commonAttrs }
  : { disabled, ...commonAttrs };
---

<Tag class={buttonClasses} {...tagProps}>
  <slot />
</Tag>

<script>
  import { canUsePointerMotion } from "../../utils/motion";

  const PULL_X = 8;
  const PULL_Y = 5;

  document.addEventListener("astro:page-load", () => {
    if (!canUsePointerMotion()) return;
    document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((el) => {
      if (el.dataset.magneticBound) return;
      el.dataset.magneticBound = "true";
      el.style.transitionProperty =
        "color, background-color, border-color, opacity, transform, translate";
      el.style.transitionDuration = "var(--duration-base)";
      el.style.transitionTimingFunction = "var(--ease-out-expo)";
      el.addEventListener("pointermove", (e) => {
        const r = el.getBoundingClientRect();
        const x = (e.clientX - (r.left + r.width / 2)) / (r.width / 2);
        const y = (e.clientY - (r.top + r.height / 2)) / (r.height / 2);
        el.style.translate = `${x * PULL_X}px ${y * PULL_Y}px`;
      });
      el.addEventListener("pointerleave", () => {
        el.style.translate = "";
      });
    });
  });
</script>
