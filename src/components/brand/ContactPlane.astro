---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<canvas
  class={`contact-plane aspect-square w-full text-text-primary print:hidden ${className}`}
  data-contact-plane
  aria-hidden="true"></canvas>

<style>
  .contact-plane {
    animation: contact-plane-in 2s var(--ease-out-expo) 0.3s both;
  }

  @keyframes contact-plane-in {
    from {
      opacity: 0;
      transform: translateX(-1.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-plane {
      animation: none;
    }
  }
</style>

<script>
  import { createPaperPlane } from "../../utils/meshes";
  import { pageScopedController } from "../../utils/motion";
  import { mountWireframe } from "../../utils/wireframe";

  document.addEventListener("astro:page-load", () => {
    const canvas = document.querySelector<HTMLCanvasElement>(
      "[data-contact-plane]",
    );
    if (!canvas) return;
    const plane = mountWireframe(canvas, {
      shape: {
        mesh: createPaperPlane(),
        tilt: -0.75,
        edgeAlpha: { back: 0.12, front: 0.45 },
        vertexDots: true,
      },
      turnSeconds: 14,
      // Seen from behind and above, nose heading up-right into the page.
      yaw: 0.9,
      sway: 0.25,
      radius: 0.46,
    });
    if (!plane) return;

    const { signal } = pageScopedController();
    window.addEventListener("app:email-copied", () => plane.fly(), { signal });
  });
</script>
