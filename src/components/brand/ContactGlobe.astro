---
import { basics } from "@cv";

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
const coordinates = basics.location?.coordinates;
---

{
  coordinates && (
    <canvas
      class={`contact-globe aspect-square w-full text-text-primary print:hidden ${className}`}
      data-contact-globe
      data-lat={coordinates.latitude}
      data-lon={coordinates.longitude}
      aria-hidden="true"
    />
  )
}

<style>
  .contact-globe {
    animation: contact-globe-in 2s var(--ease-out-expo) 0.3s both;
  }

  @keyframes contact-globe-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-globe {
      animation: none;
    }
  }
</style>

<script>
  import { createGlobe, latLonToVec3 } from "../../utils/geodesic";
  import { mountWireframe } from "../../utils/wireframe";

  document.addEventListener("astro:page-load", () => {
    const canvas = document.querySelector<HTMLCanvasElement>(
      "[data-contact-globe]",
    );
    if (!canvas) return;
    const lat = Number(canvas.dataset.lat);
    const lon = Number(canvas.dataset.lon);

    mountWireframe(canvas, {
      mesh: createGlobe(30),
      turnSeconds: 90,
      // Start with the marker just off the left limb so it rotates into view.
      yaw: -((lon * Math.PI) / 180) - 0.9,
      tilt: -0.25,
      edgeAlpha: { back: 0.04, front: 0.26 },
      marker: latLonToVec3(lat, lon),
    });
  });
</script>
