<div
  class="pointer-events-none absolute inset-0 mx-auto hidden max-w-6xl md:block print:hidden"
  aria-hidden="true"
>
  <canvas
    class="hero-wireframe absolute right-0 top-1/2 aspect-square w-[min(40vw,480px)] -translate-y-1/2 text-text-primary"
    data-hero-wireframe></canvas>
</div>

<style>
  .hero-wireframe {
    animation: hero-wireframe-in 2s var(--ease-out-expo) 0.4s both;
  }

  @keyframes hero-wireframe-in {
    from {
      opacity: 0;
      transform: translateY(-50%) scale(0.94);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-wireframe {
      animation: none;
    }
  }
</style>

<script>
  import { createIcosphere } from "../../utils/geodesic";
  import { HERO_ICONS } from "../../utils/icons";
  import { mountWireframe } from "../../utils/wireframe";

  /**
   * One original icosahedron vertex from each antipodal pair, so the icons
   * are spread evenly and never overlap.
   */
  const ICON_VERTICES = [0, 1, 4, 5, 8, 9];

  document.addEventListener("astro:page-load", () => {
    const canvas = document.querySelector<HTMLCanvasElement>(
      "[data-hero-wireframe]",
    );
    if (!canvas) return;
    const mesh = createIcosphere(1);
    mountWireframe(canvas, {
      mesh,
      icons: HERO_ICONS.map((path, i) => ({
        at: mesh.vertices[ICON_VERTICES[i]],
        path,
      })),
    });
  });
</script>
