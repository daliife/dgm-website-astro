<div
  class="pointer-events-none absolute inset-0 mx-auto hidden max-w-6xl md:block print:hidden"
  aria-hidden="true"
>
  <canvas
    class="hero-wireframe absolute right-0 top-1/2 aspect-square w-[min(40vw,480px)] -translate-y-1/2 text-text-primary"
    data-hero-wireframe></canvas>
</div>

<style>
  .hero-wireframe {
    animation: hero-wireframe-in 2s var(--ease-out-expo) 0.4s both;
  }

  @keyframes hero-wireframe-in {
    from {
      opacity: 0;
      transform: translateY(-50%) scale(0.94);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-wireframe {
      animation: none;
    }
  }
</style>

<script>
  import { createIcosphere } from "../../utils/geodesic";
  import {
    createAtom,
    createMountains,
    createSoundWave,
    createTesseract,
  } from "../../utils/meshes";
  import { pageScopedController } from "../../utils/motion";
  import { mountWireframe, type WireframeShape } from "../../utils/wireframe";

  /** One shape per typewriter phrase, in `TYPEWRITER_KEYS` order. */
  const SHAPES: WireframeShape[] = [
    { mesh: createIcosphere(1), vertexDots: true }, // frontend developer
    { mesh: createTesseract(), vertexDots: true }, // software engineer
    { mesh: createAtom(), tilt: 0.2 }, // React specialist
    { mesh: createSoundWave(), tilt: 0.35 }, // clarinettist
    { mesh: createMountains(), tilt: -0.55 }, // mountain lover
  ];

  document.addEventListener("astro:page-load", () => {
    const canvas = document.querySelector<HTMLCanvasElement>(
      "[data-hero-wireframe]",
    );
    if (!canvas) return;
    const wireframe = mountWireframe(canvas, { shape: SHAPES[0] });
    if (!wireframe) return;

    const { signal } = pageScopedController();
    window.addEventListener(
      "app:typewriter-phrase",
      (e: Event) => {
        const { index } = (e as CustomEvent<{ index: number }>).detail;
        wireframe.setShape(SHAPES[index % SHAPES.length]);
      },
      { signal },
    );
  });
</script>
