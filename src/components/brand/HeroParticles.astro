<div
  class="pointer-events-none absolute inset-0 mx-auto hidden max-w-6xl md:block print:hidden"
  aria-hidden="true"
>
  <canvas
    class="hero-particles absolute right-0 top-1/2 aspect-square w-[min(32vw,400px)] -translate-y-1/2 text-text-primary"
    data-hero-particles></canvas>
</div>

<style>
  .hero-particles {
    animation: hero-particles-in 2s var(--ease-out-expo) 0.4s both;
  }

  @keyframes hero-particles-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-particles {
      animation: none;
    }
  }
</style>

<script>
  import { HERO_ICONS } from "../../utils/icons";
  import { pageScopedController } from "../../utils/motion";
  import { mountParticleIcons } from "../../utils/particles";

  document.addEventListener("astro:page-load", () => {
    const canvas = document.querySelector<HTMLCanvasElement>(
      "[data-hero-particles]",
    );
    if (!canvas) return;
    const particles = mountParticleIcons(canvas, { icons: HERO_ICONS });
    if (!particles) return;

    const { signal } = pageScopedController();
    window.addEventListener(
      "app:hero-phrase",
      (e: Event) => {
        particles.setActive((e as CustomEvent<{ index: number }>).detail.index);
      },
      { signal },
    );
  });
</script>
