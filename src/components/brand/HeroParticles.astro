<canvas
  class="hero-particles pointer-events-none absolute inset-0 h-full w-full text-text-primary print:hidden"
  aria-hidden="true"
  data-hero-particles></canvas>

<style>
  .hero-particles {
    animation: hero-particles-in 2s var(--ease-out-expo) 0.4s both;
  }

  @keyframes hero-particles-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-particles {
      animation: none;
    }
  }
</style>

<script>
  import { HERO_ICONS } from "../../utils/icons";
  import { pageScopedController } from "../../utils/motion";
  import { mountParticleIcons, type IconSlot } from "../../utils/particles";

  /** Widest the hero content runs (Tailwind `max-w-6xl`), in CSS px. */
  const CONTENT_MAX = 1152;
  const ICON_MAX = 220;
  const ICON_MIN = 110;

  /** Right edge of the rendered name text, not of its full-width block. */
  function textRight(el: Element): number {
    let right = 0;
    const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    const range = document.createRange();
    while (walker.nextNode()) {
      range.selectNodeContents(walker.currentNode);
      for (const rect of range.getClientRects()) {
        right = Math.max(right, rect.right);
      }
    }
    return right;
  }

  document.addEventListener("astro:page-load", () => {
    const canvas = document.querySelector<HTMLCanvasElement>(
      "[data-hero-particles]",
    );
    const name = canvas?.parentElement?.querySelector("h1");
    if (!canvas || !name) return;

    /** Icon spot centred in the free space right of the name. */
    const slot = (): IconSlot | null => {
      const box = canvas.getBoundingClientRect();
      const contentRight = Math.min(
        box.right - 48,
        box.left + (box.width + CONTENT_MAX) / 2,
      );
      const left = textRight(name);
      const size = Math.min(ICON_MAX, contentRight - left - 48);
      if (size < ICON_MIN) return null;
      const title = name.getBoundingClientRect();
      return {
        x: (left + contentRight) / 2 - box.left,
        y: title.top + title.height / 2 - box.top,
        size,
      };
    };

    const particles = mountParticleIcons(canvas, { icons: HERO_ICONS, slot });
    if (!particles) return;

    const { signal } = pageScopedController();
    window.addEventListener(
      "app:hero-phrase",
      (e: Event) => {
        particles.setActive((e as CustomEvent<{ index: number }>).detail.index);
      },
      { signal },
    );
  });
</script>
