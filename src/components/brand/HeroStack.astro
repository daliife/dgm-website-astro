---
import { STACK_ICONS } from "../../utils/stackIcons";

/**
 * Positions keep clear of the left-aligned hero copy. `depth` (0–1) drives
 * the sense of distance: nearer icons are larger, sharper, brighter and move more.
 */
const LAYOUT = [
  { top: 14, left: 79, size: 64, depth: 1 },
  { top: 66, left: 88, size: 30, depth: 0.45 },
  { top: 80, left: 66, size: 22, depth: 0.3 },
  { top: 10, left: 9, size: 36, depth: 0.6 },
  { top: 38, left: 93, size: 48, depth: 0.8 },
  { top: 32, left: 69, size: 18, depth: 0.2 },
  { top: 80, left: 12, size: 52, depth: 0.85 },
  { top: 48, left: 4, size: 20, depth: 0.25 },
];

const items = STACK_ICONS.map((icon, i) => {
  const layout = LAYOUT[i % LAYOUT.length];
  const { depth } = layout;
  return {
    ...icon,
    ...layout,
    vars: [
      `top:${layout.top}%`,
      `left:${layout.left}%`,
      `--depth:${depth}`,
      `--size:${layout.size}px`,
      `--base:${(0.045 + depth * 0.06).toFixed(3)}`,
      `--blur:${((1 - depth) * 1.2).toFixed(2)}px`,
      `--amp:${Math.round(6 + depth * 10)}px`,
      `--spin:${i % 2 ? 6 : -6}deg`,
      `--dx:${17 + ((i * 5) % 12)}s`,
      `--dy:${11 + ((i * 3) % 8)}s`,
      `--delay:${-(i * 2.3).toFixed(1)}s`,
    ].join(";"),
  };
});
---

<div
  class="hero-stack pointer-events-none absolute inset-0 hidden overflow-hidden md:block print:hidden"
  data-hero-stack
  aria-hidden="true"
>
  {
    items.map((item) => (
      <span
        class="hero-stack__item absolute"
        style={item.vars}
        data-stack-item
        data-size={item.size}
      >
        <span class="hero-stack__drift block">
          <svg
            class="hero-stack__icon text-text-primary"
            viewBox="0 0 24 24"
            fill="currentColor"
            data-name={item.name}
          >
            <path d={item.path} />
          </svg>
        </span>
      </span>
    ))
  }
</div>

<style>
  .hero-stack {
    --px: 0;
    --py: 0;
    animation: hero-stack-in 1.6s var(--ease-out-expo) 0.5s both;
  }

  /* Pointer parallax (whole field) + local repel from the cursor (per icon). */
  .hero-stack__item {
    translate: calc(var(--px) * var(--depth) * -32px + var(--rx, 0px))
      calc(var(--py) * var(--depth) * -22px + var(--ry, 0px));
    transition: translate 1.1s var(--ease-out-expo);
  }

  .hero-stack__drift {
    animation: hero-stack-drift-x var(--dx) ease-in-out var(--delay) infinite
      alternate;
  }

  .hero-stack__icon {
    display: block;
    width: var(--size);
    height: var(--size);
    opacity: calc(var(--base) + var(--glow, 0) * 0.16);
    filter: blur(calc(var(--blur) * (1 - var(--glow, 0))));
    transition:
      opacity 0.6s var(--ease-out-expo),
      filter 0.6s var(--ease-out-expo);
    animation: hero-stack-drift-y var(--dy) ease-in-out var(--delay) infinite
      alternate;
  }

  :global(.dark) .hero-stack__icon {
    opacity: calc(var(--base) * 1.3 + var(--glow, 0) * 0.18);
  }

  @keyframes hero-stack-in {
    from {
      opacity: 0;
    }
  }

  @keyframes hero-stack-drift-x {
    from {
      transform: translateX(calc(var(--amp) * -1));
    }
    to {
      transform: translateX(var(--amp));
    }
  }

  @keyframes hero-stack-drift-y {
    from {
      transform: translateY(calc(var(--amp) * -0.8))
        rotate(calc(var(--spin) * -1));
    }
    to {
      transform: translateY(calc(var(--amp) * 0.8)) rotate(var(--spin));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-stack,
    .hero-stack__drift,
    .hero-stack__icon {
      animation: none;
    }
  }
</style>

<script>
  import {
    canUsePointerMotion,
    pageScopedController,
  } from "../../utils/motion";

  const REPEL_RADIUS = 180;
  const REPEL_DISTANCE = 26;

  document.addEventListener("astro:page-load", () => {
    const stack = document.querySelector<HTMLElement>("[data-hero-stack]");
    if (!stack || !canUsePointerMotion()) return;

    const items = [
      ...stack.querySelectorAll<HTMLElement>("[data-stack-item]"),
    ].map((el) => ({
      el,
      half: Number(el.dataset.size ?? 0) / 2,
      depth: Number(el.style.getPropertyValue("--depth") || 0.5),
    }));

    const { signal } = pageScopedController();
    let frame = 0;
    let pointer: { x: number; y: number } | null = null;

    const update = () => {
      frame = 0;
      const field = stack.getBoundingClientRect();
      const px = pointer ? (pointer.x / window.innerWidth) * 2 - 1 : 0;
      const py = pointer ? (pointer.y / window.innerHeight) * 2 - 1 : 0;
      stack.style.setProperty("--px", px.toFixed(3));
      stack.style.setProperty("--py", py.toFixed(3));

      for (const { el, half, depth } of items) {
        let rx = 0;
        let ry = 0;
        let glow = 0;
        if (pointer) {
          // Layout position (offset*) ignores our own translate, so no feedback loop.
          const cx = field.left + el.offsetLeft + half;
          const cy = field.top + el.offsetTop + half;
          const dx = cx - pointer.x;
          const dy = cy - pointer.y;
          const dist = Math.hypot(dx, dy) || 1;
          if (dist < REPEL_RADIUS) {
            const force = (1 - dist / REPEL_RADIUS) ** 2;
            const push = force * REPEL_DISTANCE * (0.5 + depth / 2);
            rx = (dx / dist) * push;
            ry = (dy / dist) * push;
            glow = force;
          }
        }
        el.style.setProperty("--rx", `${rx.toFixed(1)}px`);
        el.style.setProperty("--ry", `${ry.toFixed(1)}px`);
        el.style.setProperty("--glow", glow.toFixed(3));
      }
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    window.addEventListener(
      "pointermove",
      (e) => {
        pointer = { x: e.clientX, y: e.clientY };
        schedule();
      },
      { passive: true, signal },
    );
    document.documentElement.addEventListener(
      "pointerleave",
      () => {
        pointer = null;
        schedule();
      },
      { signal },
    );
    signal.addEventListener("abort", () => cancelAnimationFrame(frame));
  });
</script>
