---
import { STACK_ICONS } from "../../utils/stackIcons";

/**
 * Positions keep clear of the left-aligned hero copy. `depth` (0–1) drives
 * the sense of distance: nearer icons are larger, sharper, brighter and drift further.
 */
const LAYOUT = [
  { top: 14, left: 79, size: 64, depth: 1 },
  { top: 66, left: 88, size: 30, depth: 0.45 },
  { top: 80, left: 66, size: 22, depth: 0.3 },
  { top: 10, left: 9, size: 36, depth: 0.6 },
  { top: 38, left: 93, size: 48, depth: 0.8 },
  { top: 32, left: 69, size: 18, depth: 0.2 },
  { top: 80, left: 12, size: 52, depth: 0.85 },
  { top: 48, left: 4, size: 20, depth: 0.25 },
];

const items = STACK_ICONS.map((icon, i) => {
  const layout = LAYOUT[i % LAYOUT.length];
  const { depth } = layout;
  return {
    ...icon,
    ...layout,
    vars: [
      `top:${layout.top}%`,
      `left:${layout.left}%`,
      `--size:${layout.size}px`,
      `--base:${(0.045 + depth * 0.06).toFixed(3)}`,
      `--blur:${((1 - depth) * 1.2).toFixed(2)}px`,
      `--amp:${Math.round(6 + depth * 10)}px`,
      `--spin:${i % 2 ? 6 : -6}deg`,
      `--dx:${17 + ((i * 5) % 12)}s`,
      `--dy:${11 + ((i * 3) % 8)}s`,
      `--delay:${-(i * 2.3).toFixed(1)}s`,
    ].join(";"),
  };
});
---

<div
  class="hero-stack pointer-events-none absolute inset-0 hidden overflow-hidden md:block print:hidden"
  aria-hidden="true"
>
  {
    items.map((item) => (
      <span class="hero-stack__item absolute" style={item.vars}>
        <span class="hero-stack__drift block">
          <svg
            class="hero-stack__icon text-text-primary"
            viewBox="0 0 24 24"
            fill="currentColor"
            data-name={item.name}
          >
            <path d={item.path} />
          </svg>
        </span>
      </span>
    ))
  }
</div>

<style>
  .hero-stack {
    animation: hero-stack-in 1.6s var(--ease-out-expo) 0.5s both;
  }

  .hero-stack__drift {
    animation: hero-stack-drift-x var(--dx) ease-in-out var(--delay) infinite
      alternate;
  }

  .hero-stack__icon {
    display: block;
    width: var(--size);
    height: var(--size);
    opacity: var(--base);
    filter: blur(var(--blur));
    animation: hero-stack-drift-y var(--dy) ease-in-out var(--delay) infinite
      alternate;
  }

  :global(.dark) .hero-stack__icon {
    opacity: calc(var(--base) * 1.3);
  }

  @keyframes hero-stack-in {
    from {
      opacity: 0;
    }
  }

  @keyframes hero-stack-drift-x {
    from {
      transform: translateX(calc(var(--amp) * -1));
    }
    to {
      transform: translateX(var(--amp));
    }
  }

  @keyframes hero-stack-drift-y {
    from {
      transform: translateY(calc(var(--amp) * -0.8))
        rotate(calc(var(--spin) * -1));
    }
    to {
      transform: translateY(calc(var(--amp) * 0.8)) rotate(var(--spin));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-stack,
    .hero-stack__drift,
    .hero-stack__icon {
      animation: none;
    }
  }
</style>
