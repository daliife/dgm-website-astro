---
import { basics } from "@cv";
import { getSocialProfile } from "../../utils/socialLinks";
import { ICON_PATHS } from "../../utils/icons";
import { pageHref } from "../../utils/url";
import { t } from "../../utils/i18n";
import type { SocialProfile } from "../../types/ui";
const typedProfiles = basics.profiles as SocialProfile[];

const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    name: "LinkedIn",
    labelKey: "ui.contact.network.linkedin" as const,
    url: getSocialProfile(typedProfiles, "Linkedin")?.url || "#",
    icon: ICON_PATHS.linkedin,
    external: true,
  },
  {
    name: "GitHub",
    labelKey: "ui.contact.network.github" as const,
    url: getSocialProfile(typedProfiles, "Github")?.url || "#",
    icon: ICON_PATHS.github,
    external: true,
  },
  {
    name: "Email",
    labelKey: "ui.contact.network.email" as const,
    url: `mailto:${basics.email}`,
    icon: ICON_PATHS.email,
    external: false,
  },
];
---

<footer class="border-t border-border-primary" role="contentinfo">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-6 py-8 sm:flex-row"
  >
    <div
      class="flex flex-col items-center gap-2 min-[480px]:flex-row min-[480px]:gap-4"
    >
      <span class="text-center text-xs text-text-muted min-[480px]:text-left">
        &copy; <span id="footer-year">{currentYear}</span>
        {basics.name}
        {basics.lastName} &mdash;{" "}
        <span data-i18n="ui.footer.builtWith">{t("ui.footer.builtWith")}</span>
        {" "}
        <span class="footer-cycle-wrapper text-text-secondary"
          ><span class="footer-cycle" data-i18n="ui.footer.cycle.0"
            >{t("ui.footer.cycle.0")}</span
          ><span class="footer-cycle" data-i18n="ui.footer.cycle.1"
            >{t("ui.footer.cycle.1")}</span
          ><span class="footer-cycle" data-i18n="ui.footer.cycle.2"
            >{t("ui.footer.cycle.2")}</span
          ></span
        >
      </span>
      <a
        href={pageHref("privacy")}
        class="inline-flex shrink-0 items-center gap-1 text-xs text-text-muted transition-colors duration-200 hover:text-text-primary"
      >
        <svg
          class="h-3.5 w-3.5 shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
          ></path>
        </svg>
        <span data-i18n="ui.footer.privacy">{t("ui.footer.privacy")}</span>
      </a>
    </div>
    <nav
      aria-label={t("ui.a11y.footer.social")}
      data-i18n-aria="ui.a11y.footer.social"
    >
      <ul class="flex items-center gap-6">
        {
          socialLinks.map((link) => (
            <li>
              <a
                href={link.url}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                class="inline-flex items-center gap-1.5 text-xs uppercase tracking-widest text-text-muted transition-colors duration-200 hover:text-text-primary"
              >
                <svg
                  class="h-3.5 w-3.5 shrink-0"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  set:html={link.icon}
                />
                <span data-i18n={link.labelKey}>{t(link.labelKey)}</span>
                {link.external && (
                  <span class="sr-only" data-i18n="ui.a11y.opensNewTab">
                    {t("ui.a11y.opensNewTab")}
                  </span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<script>
  const el = document.getElementById("footer-year");
  if (el) el.textContent = String(new Date().getFullYear());
</script>

<style>
  .footer-cycle-wrapper {
    display: inline-grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1em;
    overflow: hidden;
    line-height: 1;
    vertical-align: baseline;
    min-width: 3.5ch;
  }

  .footer-cycle {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(8px);
    animation: cycle-word 9s ease-in-out infinite;
  }

  .footer-cycle:nth-child(1) {
    animation-delay: 0s;
  }
  .footer-cycle:nth-child(2) {
    animation-delay: 3s;
  }
  .footer-cycle:nth-child(3) {
    animation-delay: 6s;
  }

  @keyframes cycle-word {
    0% {
      opacity: 0;
      transform: translateY(8px);
    }
    8% {
      opacity: 1;
      transform: translateY(0);
    }
    25% {
      opacity: 1;
      transform: translateY(0);
    }
    33% {
      opacity: 0;
      transform: translateY(-8px);
    }
    100% {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-cycle {
      animation: none;
      opacity: 0;
    }
    .footer-cycle:nth-child(1) {
      opacity: 1;
      transform: none;
    }
  }
</style>
