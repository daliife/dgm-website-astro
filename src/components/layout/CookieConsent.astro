---
import { pageHref } from "../../utils/url";
import { t } from "../../utils/i18n";
import Button from "../ui/Button.astro";
---

<div
  id="cookie-banner"
  role="region"
  aria-label={t("ui.a11y.cookieNotice")}
  data-i18n-aria="ui.a11y.cookieNotice"
  transition:persist
  class="fixed bottom-0 left-0 right-0 z-50 hidden translate-y-full"
>
  <div class="border-t border-border-primary bg-bg-secondary px-6 py-4">
    <div
      class="mx-auto flex max-w-5xl flex-col items-start justify-between gap-3 sm:flex-row sm:items-center"
    >
      <p class="text-xs leading-relaxed text-text-secondary">
        <span data-i18n="ui.cookies.message">{t("ui.cookies.message")}</span>
        {" "}
        <a
          href={pageHref("privacy")}
          class="underline underline-offset-4 transition-colors hover:text-text-primary"
          data-i18n="ui.cookies.learnmore"
        >
          {t("ui.cookies.learnmore")}
        </a>
      </p>
      <div class="flex shrink-0 items-center gap-2">
        <Button id="cookie-reject" variant="ghost" size="sm">
          <span data-i18n="ui.cookies.reject">{t("ui.cookies.reject")}</span>
        </Button>
        <Button id="cookie-accept" variant="primary" size="sm">
          <span data-i18n="ui.cookies.accept">{t("ui.cookies.accept")}</span>
        </Button>
      </div>
    </div>
  </div>
</div>

<script>
  import { loadUmamiAnalytics } from "../../utils/analytics";

  const STORAGE_KEY = "cookie-consent";
  const LEGACY_KEY = "cookie-consent-dismissed";

  type ConsentValue = "accepted" | "rejected";

  function getStoredConsent(): ConsentValue | null {
    const value = localStorage.getItem(STORAGE_KEY);
    if (value === "accepted" || value === "rejected") return value;

    // Migrate pre-UX-3 dismissals: they already opted into analytics.
    if (localStorage.getItem(LEGACY_KEY) === "true") {
      localStorage.setItem(STORAGE_KEY, "accepted");
      localStorage.removeItem(LEGACY_KEY);
      return "accepted";
    }

    return null;
  }

  function hideBanner(banner: HTMLElement) {
    banner.classList.remove("translate-y-0");
    banner.classList.add("translate-y-full");
    banner.addEventListener(
      "transitionend",
      () => banner.classList.add("hidden"),
      { once: true },
    );
  }

  function initBanner() {
    const banner = document.getElementById("cookie-banner");
    if (!banner) return;

    const consent = getStoredConsent();
    if (consent === "accepted") {
      banner.classList.add("hidden");
      loadUmamiAnalytics();
      return;
    }
    if (consent === "rejected") {
      banner.classList.add("hidden");
      return;
    }

    if (banner.dataset.init === "true") return;
    banner.dataset.init = "true";

    banner.classList.remove("hidden");

    requestAnimationFrame(() => {
      banner.classList.remove("translate-y-full");
      banner.classList.add(
        "translate-y-0",
        "transition-transform",
        "duration-300",
        "ease-out",
      );
    });

    document.getElementById("cookie-accept")?.addEventListener("click", () => {
      localStorage.setItem(STORAGE_KEY, "accepted");
      localStorage.removeItem(LEGACY_KEY);
      loadUmamiAnalytics();
      hideBanner(banner);
    });

    document.getElementById("cookie-reject")?.addEventListener("click", () => {
      localStorage.setItem(STORAGE_KEY, "rejected");
      localStorage.removeItem(LEGACY_KEY);
      hideBanner(banner);
    });
  }

  document.addEventListener("astro:page-load", initBanner);
</script>
