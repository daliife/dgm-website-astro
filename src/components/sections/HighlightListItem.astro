---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<li
  class:list={["flex items-start gap-2.5 text-sm leading-relaxed", className]}
>
  <span class="mt-2 h-px w-3 shrink-0 bg-border-secondary" aria-hidden="true"
  ></span>
  <span class="text-text-secondary"><slot /></span>
</li>
