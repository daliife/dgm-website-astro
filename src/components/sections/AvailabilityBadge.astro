---
import { basics } from "@cv";
import { t } from "../../utils/i18n";

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

{
  basics.available && (
    <p
      class:list={[
        "inline-flex items-center gap-2.5 text-xs uppercase tracking-widest text-text-secondary",
        className,
      ]}
    >
      <span class="relative flex h-2 w-2" aria-hidden="true">
        <span class="availability-ping absolute inline-flex h-full w-full rounded-full bg-status-positive" />
        <span class="relative inline-flex h-2 w-2 rounded-full bg-status-positive" />
      </span>
      <span data-i18n="ui.availability.open">{t("ui.availability.open")}</span>
    </p>
  )
}

<style>
  .availability-ping {
    animation: availability-ping 2.4s var(--ease-out-expo) infinite;
  }

  @keyframes availability-ping {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .availability-ping {
      display: none;
    }
  }
</style>
