---
import type { ProjectEntry } from "../../types/ui";
import type { I18nKey } from "../../i18n/en";
import { t } from "../../utils/i18n";
import {
  CARD_FRAME_CLASSES,
  CARD_MEDIA_FRAME_CLASSES,
  WORK_DATES_CLASSES,
} from "../../utils/constants";
import { pageHref } from "../../utils/url";
import {
  getProjectImageSet,
  getProjectTransitionName,
} from "../../utils/projects";
import WorkDates from "./WorkDates.astro";

interface Props {
  project: ProjectEntry;
  projectIndex: number;
  slug: string;
  priority?: boolean;
  /** `sizes` for the screenshot; defaults to the two-column projects grid. */
  sizes?: string;
}

const {
  project,
  projectIndex,
  slug,
  priority = false,
  sizes = "(min-width: 1024px) 464px, (min-width: 640px) calc(50vw - 3rem), calc(100vw - 3rem)",
} = Astro.props;
const descriptionKey = `projects.${projectIndex}.description` as I18nKey;
const detailHref = pageHref("projects", slug);
const imageSet = getProjectImageSet(project.image);
---

<article class="group h-full" aria-labelledby={`project-${projectIndex}-title`}>
  <a href={detailHref} class="flex h-full min-w-0 flex-col">
    <div
      class={`${CARD_FRAME_CLASSES} ${CARD_MEDIA_FRAME_CLASSES} aspect-[16/10] w-full`}
    >
      {
        project.image ? (
          <img
            src={imageSet?.src ?? project.image}
            srcset={imageSet?.srcset}
            sizes={imageSet ? sizes : undefined}
            alt={project.name}
            class="h-full w-full object-cover"
            loading={priority ? "eager" : "lazy"}
            decoding="async"
            width="640"
            height="400"
            {...(priority ? { fetchpriority: "high" } : {})}
            transition:name={getProjectTransitionName(slug)}
            data-use-fallback
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center text-text-muted">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
              <circle cx="8.5" cy="8.5" r="1.5" />
              <polyline points="21 15 16 10 5 21" />
            </svg>
          </div>
        )
      }
    </div>
    <div class="mt-5 flex min-w-0 flex-1 flex-col gap-2">
      <div
        class="flex min-w-0 flex-wrap items-baseline justify-between gap-x-4 gap-y-1"
      >
        <div class="flex items-baseline gap-2">
          <h3
            id={`project-${projectIndex}-title`}
            class="link-underline-animate text-lg font-semibold text-text-primary sm:text-xl"
          >
            {project.name}
          </h3>
          <span
            class="arrow-nudge text-text-muted transition-colors group-hover:text-text-primary"
            aria-hidden="true">→</span
          >
        </div>
        {
          project.startDate && (
            <WorkDates
              startDate={project.startDate}
              endDate={project.endDate}
              className={`${WORK_DATES_CLASSES} shrink-0`}
            />
          )
        }
      </div>
      <p
        class="text-sm leading-relaxed text-text-secondary"
        data-i18n={descriptionKey}
      >
        {t(descriptionKey, project.description)}
      </p>
      {
        project.technologies && project.technologies.length > 0 && (
          <p class="mt-auto text-pretty pt-1 text-xs uppercase leading-relaxed tracking-widest text-text-muted">
            {project.technologies.join(" · ")}
          </p>
        )
      }
    </div>
  </a>
</article>

<script>
  document.addEventListener("astro:page-load", () => {
    const imgs = document.querySelectorAll<HTMLImageElement>(
      "img[data-use-fallback]",
    );
    if (!imgs.length) return;
    imgs.forEach((img) => {
      if (img.dataset.fallbackBound) return;
      img.dataset.fallbackBound = "true";
      img.addEventListener("error", function () {
        this.remove();
      });
    });
  });
</script>
