---
import type { ProjectEntry } from "../../types/ui";
import type { I18nKey } from "../../i18n/en";
import { t } from "../../utils/i18n";
import { WORK_DATES_CLASSES } from "../../utils/constants";
import { pageHref } from "../../utils/url";
import WorkDates from "./WorkDates.astro";

interface Props {
  project: ProjectEntry;
  projectIndex: number;
  slug: string;
  priority?: boolean;
}

const { project, projectIndex, slug, priority = false } = Astro.props;
const descriptionKey = `projects.${projectIndex}.description` as I18nKey;
const detailHref = pageHref("projects", slug);
---

<article
  class="group border-t border-border-primary py-8"
  aria-labelledby={`project-${projectIndex}-title`}
>
  <a
    href={detailHref}
    class="flex min-w-0 flex-row items-start gap-5 sm:gap-10"
  >
    <div class="relative h-24 w-24 shrink-0 sm:h-32 sm:w-48">
      <span class="absolute inset-0 block bg-text-primary" aria-hidden="true"
      ></span>
      {
        project.image ? (
          <img
            src={project.image}
            alt={project.name}
            class="relative z-10 h-full w-full object-cover transition-transform duration-300 ease-out [@media(hover:hover)]:group-hover:-translate-x-1 [@media(hover:hover)]:group-hover:-translate-y-1"
            loading={priority ? "eager" : "lazy"}
            decoding="async"
            width="192"
            height="128"
            {...(priority ? { fetchpriority: "high" } : {})}
            data-use-fallback
          />
        ) : (
          <div class="relative z-10 flex h-full w-full items-center justify-center bg-bg-muted text-text-muted transition-transform duration-300 ease-out [@media(hover:hover)]:group-hover:-translate-x-1 [@media(hover:hover)]:group-hover:-translate-y-1">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
              <circle cx="8.5" cy="8.5" r="1.5" />
              <polyline points="21 15 16 10 5 21" />
            </svg>
          </div>
        )
      }
    </div>
    <div
      class="grid min-w-0 flex-1 grid-cols-1 gap-1 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-x-2"
    >
      <div class="col-start-1 row-start-1 flex min-w-0 flex-col gap-2">
        <h3
          id={`project-${projectIndex}-title`}
          class="project-title w-fit max-w-full text-xl font-semibold text-text-primary transition-colors duration-200 ease-out sm:text-2xl"
        >
          {project.name}
        </h3>
        {
          project.startDate && (
            <WorkDates
              startDate={project.startDate}
              endDate={project.endDate}
              className={WORK_DATES_CLASSES}
            />
          )
        }
      </div>
      <p
        class="col-start-1 row-start-2 text-sm leading-relaxed text-text-secondary sm:col-span-2 sm:text-base"
        data-i18n={descriptionKey}
      >
        {t(descriptionKey, project.description)}
      </p>
      {
        project.technologies && project.technologies.length > 0 && (
          <span class="col-start-1 row-start-3 text-xs uppercase tracking-widest text-text-muted sm:col-start-2 sm:row-start-1 sm:whitespace-nowrap">
            {project.technologies.join(" · ")}
          </span>
        )
      }
    </div>
  </a>
</article>

<script>
  document.addEventListener("astro:page-load", () => {
    const imgs = document.querySelectorAll<HTMLImageElement>(
      "img[data-use-fallback]",
    );
    if (!imgs.length) return;
    imgs.forEach((img) => {
      if (img.dataset.fallbackBound) return;
      img.dataset.fallbackBound = "true";
      img.addEventListener("error", function () {
        this.remove();
      });
    });
  });
</script>

<style>
  @media (hover: hover) {
    .project-title {
      background-image: linear-gradient(currentColor, currentColor);
      background-size: 0% 1px;
      background-repeat: no-repeat;
      background-position: left 0 bottom 2px;
      transition:
        background-size 0.25s ease,
        color 0.2s ease;
      padding-bottom: 0.2em;
    }
    .group:hover .project-title {
      background-size: 100% 1px;
    }
  }
</style>
