---
import type { I18nKey } from "../../i18n/en";
import {
  ABOUT_SECTION_HEADING_CLASSES,
  SECTION_LABEL_CLASSES,
} from "../../utils/constants";
import { t } from "../../utils/i18n";

interface Props {
  titleKey: I18nKey;
  labelKey?: I18nKey;
  id?: string;
  headingClasses?: string;
}

const {
  titleKey,
  labelKey,
  id,
  headingClasses = ABOUT_SECTION_HEADING_CLASSES,
} = Astro.props;
---

<header>
  {
    labelKey && (
      <p class={SECTION_LABEL_CLASSES} data-i18n={labelKey}>
        {t(labelKey)}
      </p>
    )
  }
  <h2 class={headingClasses} id={id} data-i18n={titleKey}>
    {t(titleKey)}
  </h2>
</header>
