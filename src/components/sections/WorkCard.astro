---
import { t } from "../../utils/i18n";
import {
  CONTENT_LIST_CLASSES,
  WORK_COMPANY_LINK_CLASSES,
  WORK_DATES_CLASSES,
} from "../../utils/constants";
import type { WorkEntry } from "../../types/ui";
import type { I18nKey } from "../../i18n/en";
import HighlightListItem from "./HighlightListItem.astro";
import WorkDates from "./WorkDates.astro";

interface Props {
  job: WorkEntry;
  jobIndex: number;
}

const { job, jobIndex } = Astro.props;

const highlights = job.highlights ?? [];
const hasSummary = Boolean(job.summary);
const hasHighlights = highlights.length > 0;
const hasList = hasSummary || hasHighlights;
---

<article class="border-t border-border-primary py-8">
  <header class="mb-6 flex max-w-2xl flex-col gap-2.5">
    <h2 class="text-lg leading-snug text-text-primary sm:text-xl">
      <span class="font-semibold" data-i18n={`work.${jobIndex}.position`}>
        {t(`work.${jobIndex}.position` as I18nKey, job.position)}
      </span>
      <span class="font-normal text-text-muted" aria-hidden="true"> @ </span>
      <a
        href={job.url}
        target="_blank"
        rel="noopener noreferrer"
        class={`${WORK_COMPANY_LINK_CLASSES} font-normal`}
      >
        {job.company}
        <span class="sr-only" data-i18n="ui.a11y.opensNewTab"
          >{t("ui.a11y.opensNewTab")}</span
        >
      </a>
    </h2>
    <WorkDates
      startDate={job.startDate}
      endDate={job.endDate}
      className={WORK_DATES_CLASSES}
    />
  </header>

  {
    hasList && (
      <ul class={CONTENT_LIST_CLASSES}>
        {hasSummary && (
          <HighlightListItem>
            <span data-i18n={`work.${jobIndex}.summary`}>
              {t(`work.${jobIndex}.summary` as I18nKey, job.summary!)}
            </span>
          </HighlightListItem>
        )}
        {highlights.map((h: string, hIndex: number) => (
          <HighlightListItem>
            <span data-i18n={`work.${jobIndex}.highlights.${hIndex}`}>
              {t(`work.${jobIndex}.highlights.${hIndex}` as I18nKey, h)}
            </span>
          </HighlightListItem>
        ))}
      </ul>
    )
  }
</article>
