---
import Layout from "../../layouts/Layout.astro";
import { projects } from "@cv";
import {
  BREADCRUMB_LINK_CLASSES,
  CARD_FRAME_CLASSES,
  CARD_MEDIA_FRAME_CLASSES,
  PAGE_CONTAINER_CLASSES,
  PROJECT_DETAIL_CTA_CLASSES,
  PROJECT_DETAIL_CTA_SECONDARY_CLASSES,
  CONTENT_LIST_CLASSES,
  LINK_UNDERLINE_SECONDARY_CLASSES,
  WORK_DATES_CLASSES,
  LIVE_URL,
} from "../../utils/constants";
import HighlightListItem from "../../components/sections/HighlightListItem.astro";
import { pageHref } from "../../utils/url";
import { t } from "../../utils/i18n";
import type { I18nKey } from "../../i18n/en";
import type { ProjectEntry } from "../../types/ui";
import {
  findProjectBySlug,
  getAdjacentProjects,
  getProjectEntries,
  getProjectImageSet,
  getProjectTransitionName,
  isGitHubRepoUrl,
} from "../../utils/projects";
import { getPageTitle } from "../../utils/seo";
import WorkDates from "../../components/sections/WorkDates.astro";
import Button from "../../components/ui/Button.astro";
import NextUpNav from "../../components/layout/NextUpNav.astro";

export function getStaticPaths() {
  return getProjectEntries(projects as ProjectEntry[]).map(({ slug }) => ({
    params: { slug },
  }));
}

const slug = Astro.params.slug!;
const entry = findProjectBySlug(projects as ProjectEntry[], slug);

if (!entry) {
  throw new Error(`Unknown project slug: ${slug}`);
}

const { project, index } = entry;
const { prev, next } = getAdjacentProjects(projects as ProjectEntry[], slug);

const descriptionKey = `projects.${index}.description` as I18nKey;
const longDescriptionKey = `projects.${index}.longDescription` as I18nKey;
const localizedDescription = t(descriptionKey, project.description);
const localizedLongDescription = t(
  longDescriptionKey,
  project.longDescription ?? project.description,
);
const categoryKey = project.category
  ? (`ui.projects.category.${project.category}` as I18nKey)
  : undefined;

const githubHref =
  project.githubUrl ??
  (project.url && isGitHubRepoUrl(project.url) ? project.url : undefined);
const visitHref =
  project.url && (!githubHref || project.url !== githubHref)
    ? project.url
    : undefined;

const ogImage = project.image ? `${LIVE_URL}${project.image}` : undefined;
const heroImage = getProjectImageSet(project.image);
const hasHighlights = Boolean(project.highlights?.length);
const hasTech = Boolean(project.technologies?.length);

const creativeWorkSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.name,
  description: localizedDescription,
  url: `${LIVE_URL}/projects/${slug}/`,
  ...(project.image ? { image: `${LIVE_URL}${project.image}` } : {}),
  ...(project.url || project.githubUrl
    ? {
        sameAs: [project.url, project.githubUrl].filter(Boolean),
      }
    : {}),
  ...(project.technologies?.length
    ? { keywords: project.technologies.join(", ") }
    : {}),
  ...(project.startDate ? { dateCreated: project.startDate } : {}),
  ...(project.endDate ? { dateModified: project.endDate } : {}),
};
---

<Layout
  title={getPageTitle(project.name)}
  description={localizedDescription}
  image={ogImage}
  imageWidth={480}
  imageHeight={320}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(creativeWorkSchema)}
  />
  <div class={PAGE_CONTAINER_CLASSES}>
    <nav
      class="reveal mb-8"
      aria-label={t("ui.a11y.breadcrumb")}
      data-i18n-aria="ui.a11y.breadcrumb"
    >
      <ol
        class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs uppercase tracking-widest"
      >
        <li>
          <Button
            href={pageHref("projects")}
            variant="simple"
            size="none"
            className={BREADCRUMB_LINK_CLASSES}
          >
            <span data-i18n="ui.page.projects">{t("ui.page.projects")}</span>
          </Button>
        </li>
        <li class="text-text-muted" aria-hidden="true">/</li>
        <li
          class="max-w-[min(100%,20rem)] truncate text-text-primary"
          aria-current="page"
        >
          {project.name}
        </li>
      </ol>
    </nav>

    <!-- Header: identity, then the way out -->
    <header class="reveal">
      <div
        class="mb-3 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-xs uppercase tracking-widest text-text-muted"
      >
        {categoryKey && <span data-i18n={categoryKey}>{t(categoryKey)}</span>}
        {
          categoryKey && project.startDate && (
            <span aria-hidden="true" class="text-border-secondary">
              ·
            </span>
          )
        }
        {
          project.startDate && (
            <WorkDates
              startDate={project.startDate}
              endDate={project.endDate}
              className={WORK_DATES_CLASSES}
            />
          )
        }
      </div>

      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
        <h1
          class="max-w-3xl text-4xl font-bold uppercase tracking-tight text-text-primary sm:text-5xl"
        >
          {project.name}
        </h1>
        {
          (visitHref || githubHref) && (
            <div class="flex flex-wrap gap-x-8 gap-y-3">
              {visitHref && (
                <Button
                  href={visitHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  variant="simple"
                  size="none"
                  className={PROJECT_DETAIL_CTA_CLASSES}
                >
                  <span data-i18n="ui.projects.visit">
                    {t("ui.projects.visit")}
                  </span>
                  <span class="sr-only" data-i18n="ui.a11y.opensNewTab">
                    {t("ui.a11y.opensNewTab")}
                  </span>
                </Button>
              )}
              {githubHref && (
                <Button
                  href={githubHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  variant="simple"
                  size="none"
                  className={
                    visitHref
                      ? PROJECT_DETAIL_CTA_SECONDARY_CLASSES
                      : PROJECT_DETAIL_CTA_CLASSES
                  }
                >
                  <span data-i18n="ui.projects.github">
                    {t("ui.projects.github")}
                  </span>
                  <span class="sr-only" data-i18n="ui.a11y.opensNewTab">
                    {t("ui.a11y.opensNewTab")}
                  </span>
                </Button>
              )}
            </div>
          )
        }
      </div>
    </header>

    <!-- Screenshot beside the writing on a wide screen, so the text is on the first screen -->
    <div
      class:list={[
        "mt-8",
        project.image &&
          "lg:grid lg:grid-cols-[minmax(0,1.25fr)_minmax(16rem,1fr)] lg:items-start lg:gap-x-12",
      ]}
    >
      {
        project.image && (
          <figure class="min-w-0">
            <div
              class={`${CARD_FRAME_CLASSES} ${CARD_MEDIA_FRAME_CLASSES} aspect-[16/10] w-full`}
            >
              <img
                src={heroImage?.src ?? project.image}
                srcset={heroImage?.srcset}
                sizes={
                  heroImage
                    ? "(min-width: 1024px) 34rem, calc(100vw - 3rem)"
                    : undefined
                }
                alt={project.name}
                class="h-full w-full object-cover"
                width="1280"
                height="800"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                transition:name={getProjectTransitionName(slug)}
              />
            </div>
          </figure>
        )
      }

      <div
        class:list={[
          "reveal min-w-0",
          project.image && "mt-10 lg:mt-0",
          !project.image && "max-w-xl",
        ]}
      >
        <p
          class="text-base leading-relaxed text-text-secondary"
          data-i18n={longDescriptionKey}
        >
          {localizedLongDescription}
        </p>

        {
          (hasHighlights || hasTech) && (
            <div class="mt-10 flex flex-col gap-10">
              {hasHighlights && (
                <section aria-labelledby="project-highlights-heading">
                  <h2
                    id="project-highlights-heading"
                    class="mb-4 text-xs uppercase tracking-widest text-text-muted"
                    data-i18n="ui.projects.highlights"
                  >
                    {t("ui.projects.highlights")}
                  </h2>
                  <ul class={CONTENT_LIST_CLASSES}>
                    {project.highlights!.map((highlight, highlightIndex) => {
                      const highlightKey =
                        `projects.${index}.highlights.${highlightIndex}` as I18nKey;
                      return (
                        <HighlightListItem>
                          <span data-i18n={highlightKey}>
                            {t(highlightKey, highlight)}
                          </span>
                        </HighlightListItem>
                      );
                    })}
                  </ul>
                </section>
              )}
              {hasTech && (
                <section aria-labelledby="project-tech-heading">
                  <h2
                    id="project-tech-heading"
                    class="mb-4 text-xs uppercase tracking-widest text-text-muted"
                    data-i18n="ui.projects.tech"
                  >
                    {t("ui.projects.tech")}
                  </h2>
                  <ul class="flex flex-col gap-1.5">
                    {project.technologies!.map((technology) => (
                      <li class="text-sm leading-relaxed text-text-secondary">
                        {technology}
                      </li>
                    ))}
                  </ul>
                </section>
              )}
            </div>
          )
        }
      </div>
    </div>

    {
      (prev || next) && (
        <nav
          class="reveal mt-16 border-t border-border-primary pt-8"
          aria-label={t("ui.a11y.projectNav")}
          data-i18n-aria="ui.a11y.projectNav"
        >
          <div class="flex items-start justify-between gap-6">
            {prev ? (
              <Button
                href={pageHref("projects", prev.slug)}
                variant="simple"
                size="none"
                className="max-w-[45%] !flex-col !items-start !gap-1 text-left"
              >
                <span
                  class="text-xs uppercase tracking-widest text-text-muted"
                  data-i18n="ui.projects.prev"
                >
                  {t("ui.projects.prev")}
                </span>
                <span class={`${LINK_UNDERLINE_SECONDARY_CLASSES} text-base`}>
                  ← {prev.project.name}
                </span>
              </Button>
            ) : (
              <span />
            )}
            {next ? (
              <Button
                href={pageHref("projects", next.slug)}
                variant="simple"
                size="none"
                className="ml-auto max-w-[45%] !flex-col !items-end !gap-1 text-right"
              >
                <span
                  class="text-xs uppercase tracking-widest text-text-muted"
                  data-i18n="ui.projects.next"
                >
                  {t("ui.projects.next")}
                </span>
                <span class={`${LINK_UNDERLINE_SECONDARY_CLASSES} text-base`}>
                  {next.project.name} →
                </span>
              </Button>
            ) : (
              <span />
            )}
          </div>
        </nav>
      )
    }

    <div class="mt-8">
      <NextUpNav
        links={[
          { href: pageHref("projects"), labelKey: "ui.nextup.projects" },
          { href: pageHref("contact"), labelKey: "ui.nextup.contact" },
        ]}
      />
    </div>
  </div>
</Layout>
