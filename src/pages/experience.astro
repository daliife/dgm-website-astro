---
import Layout from "../layouts/Layout.astro";
import { work } from "@cv";
import {
  PAGE_CONTAINER_CLASSES,
  PAGE_HEADING_CLASSES,
  PAGE_HEADING_MARGIN_CLASSES,
} from "../utils/constants";
import { pageHref } from "../utils/url";
import WorkCard from "../components/sections/WorkCard.astro";
import NextUpNav from "../components/layout/NextUpNav.astro";
import { t } from "../utils/i18n";
import { getPageTitleFromKey } from "../utils/seo";
import type { WorkEntry } from "../types/ui";
---

<Layout
  title={getPageTitleFromKey("ui.page.experience")}
  description={t("ui.meta.experience.description")}
>
  <div class={PAGE_CONTAINER_CLASSES}>
    <h1
      class={`${PAGE_HEADING_CLASSES} ${PAGE_HEADING_MARGIN_CLASSES}`}
      data-i18n="ui.page.experience"
    >
      {t("ui.page.experience")}
    </h1>
    <div class="reveal-stagger space-y-0 [&>article:first-child]:border-t-0">
      {work.map((job: WorkEntry, i: number) => <WorkCard {job} jobIndex={i} />)}
    </div>

    <NextUpNav
      links={[
        { href: pageHref("projects"), labelKey: "ui.nextup.projects" },
        { href: pageHref("contact"), labelKey: "ui.nextup.contact" },
      ]}
    />
  </div>
</Layout>
