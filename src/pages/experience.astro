---
import Layout from "../layouts/Layout.astro";
import { certificates, education, work } from "@cv";
import {
  PAGE_CONTAINER_CLASSES,
  PAGE_HEADING_CLASSES,
  PAGE_HEADING_MARGIN_CLASSES,
  TIMELINE_LIST_CLASSES,
  NEXTUP_NAV_CLASSES,
} from "../utils/constants";
import { pageHref } from "../utils/url";
import WorkCard from "../components/sections/WorkCard.astro";
import EducationSection from "../components/sections/EducationSection.astro";
import CertificatesSection from "../components/sections/CertificatesSection.astro";
import NextUpNav from "../components/layout/NextUpNav.astro";
import { t } from "../utils/i18n";
import { getPageTitleFromKey } from "../utils/seo";
import type { WorkEntry } from "../types/ui";
---

<Layout
  title={getPageTitleFromKey("ui.page.experience")}
  description={t("ui.meta.experience.description")}
>
  <div class={PAGE_CONTAINER_CLASSES}>
    <h1
      class={`${PAGE_HEADING_CLASSES} ${PAGE_HEADING_MARGIN_CLASSES}`}
      data-i18n="ui.page.experience"
    >
      {t("ui.page.experience")}
    </h1>
    <div class={`reveal-stagger ${TIMELINE_LIST_CLASSES}`}>
      {work.map((job: WorkEntry, i: number) => <WorkCard {job} jobIndex={i} />)}
    </div>

    <EducationSection {education} />
    <CertificatesSection {certificates} />

    <NextUpNav
      className={`${NEXTUP_NAV_CLASSES} mt-16 md:mt-20`}
      links={[
        { href: pageHref("projects"), labelKey: "ui.nextup.projects" },
        { href: pageHref("contact"), labelKey: "ui.nextup.contact" },
      ]}
    />
  </div>
</Layout>

<script>
  import { clamp, pageScopedController } from "../utils/motion";

  /** Fraction of the viewport height where the timeline "reading head" sits. */
  const ANCHOR = 0.6;

  document.addEventListener("astro:page-load", () => {
    const items = [
      ...document.querySelectorAll<HTMLElement>("[data-timeline-item]"),
    ].map((item) => ({
      rail: item.querySelector<HTMLElement>(".timeline-rail"),
      fill: item.querySelector<HTMLElement>("[data-timeline-fill]"),
      marker: item.querySelector<HTMLElement>("[data-timeline-marker]"),
    }));
    if (!items.length) return;

    const { signal } = pageScopedController();
    let frame = 0;

    const update = () => {
      frame = 0;
      const atBottom =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 2;
      const anchor = window.innerHeight * ANCHOR;

      for (const { rail, fill, marker } of items) {
        if (marker) {
          const reached =
            atBottom || marker.getBoundingClientRect().top < anchor;
          marker.toggleAttribute("data-reached", reached);
        }
        if (rail && fill) {
          const r = rail.getBoundingClientRect();
          const progress = atBottom
            ? 1
            : clamp((anchor - r.top) / Math.max(r.height, 1), 0, 1);
          fill.style.transform = `scaleY(${progress.toFixed(3)})`;
        }
      }
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    window.addEventListener("scroll", schedule, { passive: true, signal });
    window.addEventListener("resize", schedule, { passive: true, signal });
    signal.addEventListener("abort", () => cancelAnimationFrame(frame));
    update();
  });
</script>
