---
import Layout from "../layouts/Layout.astro";
import { basics } from "@cv";
import {
  PAGE_CONTAINER_CLASSES,
  PAGE_HEADING_CLASSES,
  PAGE_HEADING_MARGIN_COMPACT_CLASSES,
} from "../utils/constants";
import { ICON_PATHS } from "../utils/icons";
import type { I18nKey } from "../i18n/en";
import type { SocialNetwork, SocialProfile } from "../types/ui";
import Button from "../components/ui/Button.astro";
import { t } from "../utils/i18n";
import { getFullName, getPageTitleFromKey } from "../utils/seo";
import { Image } from "astro:assets";
import profileImgSrc from "../assets/images/david-profile.webp";
const { email, profiles } = basics;
const fullName = getFullName();

const CONTACT_ICONS: Record<string, string> = {
  Github: ICON_PATHS.github,
  Linkedin: ICON_PATHS.linkedin,
};

const NETWORK_I18N: Record<SocialNetwork, I18nKey> = {
  Email: "ui.contact.network.email",
  Linkedin: "ui.contact.network.linkedin",
  Github: "ui.contact.network.github",
};

const CONTACT_LABEL_CLASS =
  "flex items-center gap-1.5 text-xs uppercase tracking-widest text-text-muted";

const CONTACT_ROW_BASE =
  "flex w-full items-center justify-between gap-6 border-t border-border-primary py-6";

const CONTACT_ROW_CLASS = `${CONTACT_ROW_BASE} !flex !items-center !justify-between rounded-none hover:no-underline group`;

const CONTACT_VALUE_CLASS =
  "link-underline-animate w-fit text-lg font-normal text-text-primary sm:text-xl";
---

<Layout
  title={getPageTitleFromKey("ui.page.contact")}
  description={t("ui.meta.contact.description")}
>
  <div class={PAGE_CONTAINER_CLASSES}>
    <div class="grid grid-cols-1 gap-x-16 md:grid-cols-[5fr_7fr]">
      <div>
        <h1
          class={`${PAGE_HEADING_CLASSES} ${PAGE_HEADING_MARGIN_COMPACT_CLASSES}`}
          data-i18n="ui.page.contact"
        >
          {t("ui.page.contact")}
        </h1>
        <p
          class="reveal max-w-md text-base leading-relaxed text-text-secondary sm:text-lg"
          data-i18n="ui.contact.intro"
        >
          {t("ui.contact.intro")}
        </p>

        <div
          class="reveal mb-12 mt-10 flex items-center gap-4 md:mb-0 md:mt-12"
        >
          <Image
            src={profileImgSrc}
            alt={`${t("ui.a11y.portraitOf")} ${fullName}`}
            data-i18n-alt="ui.a11y.portraitOf"
            data-alt-name={fullName}
            class="h-[4.5rem] w-14 shrink-0 rounded-md object-cover grayscale"
            width={56}
            height={72}
            widths={[56, 112]}
            sizes="56px"
            fit="cover"
            format="webp"
            quality={85}
          />
          <div class="flex min-w-0 flex-col gap-1.5">
            <p class="text-sm font-medium text-text-primary">{fullName}</p>
            <p class="text-xs uppercase tracking-widest text-text-muted">
              <span data-i18n="basics.location">{t("basics.location")}</span>
              <span class="hidden" data-local-time-wrap>
                · <time data-local-time></time>
              </span>
            </p>
            <p
              class="hidden items-center gap-2 text-xs text-text-secondary"
              data-local-status
            >
              <span
                class="h-1.5 w-1.5 shrink-0 rounded-full bg-text-muted"
                data-local-dot></span>
              <span
                class="hidden"
                data-status-open
                data-i18n="ui.contact.status.open"
              >
                {t("ui.contact.status.open")}
              </span>
              <span data-status-closed data-i18n="ui.contact.status.closed">
                {t("ui.contact.status.closed")}
              </span>
            </p>
          </div>
        </div>
      </div>

      <div class="reveal-stagger border-b border-border-primary md:mt-3">
        <div class={`${CONTACT_ROW_BASE} group`}>
          <Button
            id="contact-email-link"
            href={`mailto:${email}`}
            variant="simple"
            size="none"
            className="!flex min-w-0 flex-1 !items-start !justify-start hover:no-underline"
          >
            <span class="flex min-w-0 flex-col gap-2">
              <span class={CONTACT_LABEL_CLASS}>
                <svg
                  class="h-3.5 w-3.5 shrink-0"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <Fragment set:html={ICON_PATHS.email} />
                </svg>
                <span data-i18n="ui.contact.network.email">
                  {t("ui.contact.network.email")}
                </span>
              </span>
              <span class={`${CONTACT_VALUE_CLASS} break-all`}>{email}</span>
            </span>
          </Button>
          <Button
            id="copy-email"
            variant="outline"
            size="sm"
            className="hidden shrink-0"
          >
            <span data-copy-idle class="inline-flex items-center gap-2">
              <svg
                class="h-4 w-4 shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <Fragment set:html={ICON_PATHS.copy} />
              </svg>
              <span data-i18n="ui.contact.copy">{t("ui.contact.copy")}</span>
            </span>
            <span data-copy-done class="hidden items-center gap-2">
              <svg
                class="h-4 w-4 shrink-0 text-status-positive"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <Fragment set:html={ICON_PATHS.check} />
              </svg>
              <span data-i18n="ui.contact.copied">{t("ui.contact.copied")}</span
              >
            </span>
          </Button>
          <span id="copy-email-status" class="sr-only" aria-live="polite"
          ></span>
        </div>
        {
          (profiles as SocialProfile[]).map((profile) => {
            if (profile.network === "Email") return null;
            const icon = CONTACT_ICONS[profile.network];
            const labelKey = NETWORK_I18N[profile.network];
            return (
              <Button
                href={profile.url}
                target="_blank"
                rel="noopener noreferrer"
                variant="simple"
                size="none"
                className={CONTACT_ROW_CLASS}
              >
                <span class="flex min-w-0 flex-col gap-2">
                  <span class={CONTACT_LABEL_CLASS}>
                    {icon && (
                      <svg
                        class="h-3.5 w-3.5 shrink-0"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <Fragment set:html={icon} />
                      </svg>
                    )}
                    <span data-i18n={labelKey}>{t(labelKey)}</span>
                  </span>
                  <span class={CONTACT_VALUE_CLASS}>
                    {profile.username || profile.network}
                  </span>
                </span>
                <span
                  class="arrow-nudge arrow-nudge--external text-xl text-text-muted transition-colors group-hover:text-text-primary"
                  aria-hidden="true"
                >
                  ↗
                </span>
                <span class="sr-only" data-i18n="ui.a11y.opensNewTab">
                  {t("ui.a11y.opensNewTab")}
                </span>
              </Button>
            );
          })
        }
      </div>
    </div>

    <Button
      href={`mailto:${email}`}
      variant="simple"
      size="none"
      className="reveal group mt-20 !flex w-full !items-end !justify-between gap-6 border-b border-border-primary pb-6 hover:no-underline md:mt-28"
    >
      <span
        class="text-6xl font-bold uppercase leading-none tracking-tight text-text-primary sm:text-8xl lg:text-9xl"
        data-i18n="ui.contact.cta"
      >
        {t("ui.contact.cta")}
      </span>
      <span class="sr-only">{email}</span>
      <span
        class="arrow-nudge mb-1 text-4xl text-text-muted transition-colors duration-base group-hover:text-text-primary sm:mb-2 sm:text-6xl"
        aria-hidden="true"
      >
        →
      </span>
    </Button>
  </div>
</Layout>

<script>
  import { getStoredLang, loadLang } from "../utils/i18n-client";
  import { getLocalTimeInfo } from "../utils/localTime";
  import { pageScopedController } from "../utils/motion";

  let resetTimer: number | undefined;

  document.addEventListener("astro:page-load", () => {
    const timeEl = document.querySelector<HTMLTimeElement>("[data-local-time]");
    const timeWrap = document.querySelector<HTMLElement>(
      "[data-local-time-wrap]",
    );
    const status = document.querySelector<HTMLElement>("[data-local-status]");
    if (!timeEl || !timeWrap || !status) return;

    const dot = status.querySelector<HTMLElement>("[data-local-dot]")!;
    const open = status.querySelector<HTMLElement>("[data-status-open]")!;
    const closed = status.querySelector<HTMLElement>("[data-status-closed]")!;

    const tick = () => {
      const { time, zone, isWorkingHours } = getLocalTimeInfo(new Date());
      timeEl.textContent = `${time} ${zone}`;
      timeEl.dateTime = new Date().toISOString();
      dot.classList.toggle("bg-status-positive", isWorkingHours);
      dot.classList.toggle("bg-text-muted", !isWorkingHours);
      open.classList.toggle("hidden", !isWorkingHours);
      closed.classList.toggle("hidden", isWorkingHours);
    };

    tick();
    timeWrap.classList.remove("hidden");
    status.classList.replace("hidden", "flex");
    const { signal } = pageScopedController();
    const interval = window.setInterval(tick, 15_000);
    signal.addEventListener("abort", () => window.clearInterval(interval));
  });

  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("copy-email");
    const status = document.getElementById("copy-email-status");
    const link = document.getElementById("contact-email-link");
    if (!btn || !status || !link || !navigator.clipboard) return;

    const email = link.getAttribute("href")!.replace(/^mailto:/, "");
    const idle = btn.querySelector<HTMLElement>("[data-copy-idle]")!;
    const done = btn.querySelector<HTMLElement>("[data-copy-done]")!;

    btn.classList.remove("hidden");

    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        return;
      }
      const translations = await loadLang(getStoredLang());
      status.textContent = translations["ui.contact.copied"];
      idle.classList.add("hidden");
      done.classList.replace("hidden", "inline-flex");

      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        done.classList.replace("inline-flex", "hidden");
        idle.classList.remove("hidden");
        status.textContent = "";
      }, 2000);
    });
  });
</script>
