---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import { pageHref } from "../utils/url";
import { t } from "../utils/i18n";
import ProjectCard from "../components/sections/ProjectCard.astro";
import HeroParticles from "../components/brand/HeroParticles.astro";
import {
  EDITORIAL_LINK_SM_CLASSES,
  HOME_CTA_PRIMARY_CLASSES,
  HOME_CTA_SECONDARY_CLASSES,
  REVEAL_STAGGER_LIST_CLASSES,
} from "../utils/constants";
import { getFeaturedProjects } from "../utils/cvStats";
import type { ProjectEntry } from "../types/ui";
import { basics, projects } from "@cv";
const { name, lastName, email } = basics;
const featured = getFeaturedProjects(projects as ProjectEntry[]);
---

<Layout title={`${name} ${lastName} — ${t("basics.label")}`} type="profile">
  <section
    class="relative flex min-h-[70svh] flex-col items-center justify-center px-6 pt-16 md:min-h-[72svh]"
  >
    <HeroParticles />
    <div class="home-enter relative w-full max-w-4xl">
      <!-- Greeting -->
      <p
        class="home-enter__item mb-4 text-xs uppercase tracking-widest text-text-muted"
        data-i18n="ui.home.greeting"
      >
        {t("ui.home.greeting")}
      </p>

      <!-- Name -->
      <h1
        class="home-enter__item mb-4 text-5xl font-bold uppercase leading-none tracking-tight text-text-primary sm:text-7xl lg:text-8xl"
      >
        <span class="block">{name}</span>
        <span class="block font-light">{lastName}</span>
      </h1>

      <!-- Rotating descriptor: phrases roll up; the hero particles follow along -->
      <p
        class="home-enter__item mb-10 flex min-h-[2.75em] text-2xl font-light uppercase tracking-widest text-text-secondary max-sm:text-xl sm:min-h-[1.5em] sm:items-center sm:whitespace-nowrap sm:text-3xl"
      >
        <span class="hero-roll" data-hero-roll aria-hidden="true">
          <span>{t("basics.label")}</span>
        </span>
        <span class="sr-only" data-i18n="basics.label">{t("basics.label")}</span
        >
      </p>

      <!-- CTAs -->
      <div
        class="home-enter__item flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-8"
      >
        <Button
          href={pageHref("projects")}
          variant="simple"
          size="none"
          className={HOME_CTA_PRIMARY_CLASSES}
        >
          <svg
            class="h-4 w-4 shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
            ></path>
          </svg>
          <span data-i18n="ui.home.cta.work">{t("ui.home.cta.work")}</span>
        </Button>
        <Button
          href={`mailto:${email}`}
          variant="simple"
          size="none"
          className={HOME_CTA_SECONDARY_CLASSES}
        >
          <svg
            class="h-4 w-4 shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          <span data-i18n="ui.home.cta">{t("ui.home.cta")}</span>
        </Button>
      </div>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section
        class="mx-auto max-w-5xl px-6 pb-24 pt-8"
        aria-labelledby="home-selected-heading"
      >
        <div class="reveal mb-8 flex items-baseline justify-between gap-6 border-t border-border-primary pt-6">
          <h2
            id="home-selected-heading"
            class="text-xs uppercase tracking-widest text-text-muted"
            data-i18n="ui.home.selected"
          >
            {t("ui.home.selected")}
          </h2>
          <Button
            href={pageHref("projects")}
            variant="simple"
            size="none"
            className={`group ${EDITORIAL_LINK_SM_CLASSES} gap-1.5`}
          >
            <span data-i18n="ui.home.allProjects">
              {t("ui.home.allProjects")}
            </span>
            <span class="arrow-nudge" aria-hidden="true">
              →
            </span>
          </Button>
        </div>
        <ul
          class={`${REVEAL_STAGGER_LIST_CLASSES} grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3`}
        >
          {featured.map(({ project, index, slug }, i) => (
            <li class:list={[i === 2 && "sm:max-lg:hidden"]}>
              <ProjectCard
                {project}
                projectIndex={index}
                {slug}
                sizes="(min-width: 1024px) 299px, (min-width: 640px) calc(50vw - 3rem), calc(100vw - 3rem)"
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>

<style>
  .home-enter__item {
    opacity: 0;
    transform: translateY(10px);
    animation: home-enter 0.55s ease forwards;
  }

  .home-enter__item:nth-child(1) {
    animation-delay: 0.04s;
  }
  .home-enter__item:nth-child(2) {
    animation-delay: 0.1s;
  }
  .home-enter__item:nth-child(3) {
    animation-delay: 0.16s;
  }
  .home-enter__item:nth-child(4) {
    animation-delay: 0.22s;
  }
  @keyframes home-enter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-roll {
    display: inline-grid;
    overflow: hidden;
  }

  .hero-roll > :global(*) {
    grid-area: 1 / 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-enter__item {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  import { getTypewriterPhrases } from "../utils/typewriter";
  import { getStoredLang } from "../utils/i18n-client";
  import type { LangCode } from "../utils/i18n";

  import { prefersReducedMotion } from "../utils/motion";

  const HOLD_MS = 3500;
  const ROLL_MS = 700;
  const ROLL_EASING = "cubic-bezier(0.22, 1, 0.36, 1)";

  let stopCurrent: (() => void) | null = null;

  /** Lets the hero particles draw the icon for the current phrase. */
  function announcePhrase(index: number) {
    window.dispatchEvent(
      new CustomEvent("app:hero-phrase", { detail: { index } }),
    );
  }

  function word(text: string) {
    const span = document.createElement("span");
    span.textContent = text;
    return span;
  }

  /** Next phrase slides up into the slot while the current one exits above. */
  function roll(slot: HTMLElement, text: string) {
    const outgoing = slot.firstElementChild as HTMLElement | null;
    const incoming = word(text);
    slot.append(incoming);
    // Travel the slot height so phrases wrapping to different line counts
    // still fully enter and leave.
    const travel = `${slot.offsetHeight}px`;
    const options = { duration: ROLL_MS, easing: ROLL_EASING };
    incoming.animate(
      [{ transform: `translateY(${travel})` }, { transform: "translateY(0)" }],
      options,
    );
    outgoing
      ?.animate(
        [
          { transform: "translateY(0)" },
          { transform: `translateY(-${travel})` },
        ],
        { ...options, fill: "forwards" },
      )
      .finished.then(() => outgoing.remove())
      .catch(() => {});
  }

  async function startRoll(lang: LangCode) {
    const slot = document.querySelector<HTMLElement>("[data-hero-roll]");
    if (!slot) return;

    stopCurrent?.();
    let timer = 0;
    stopCurrent = () => window.clearTimeout(timer);

    const phrases = await getTypewriterPhrases(lang);
    slot.replaceChildren(word(phrases[0]));
    announcePhrase(0);
    if (prefersReducedMotion()) return;

    let index = 0;
    const next = () => {
      index = (index + 1) % phrases.length;
      roll(slot, phrases[index]);
      announcePhrase(index);
      timer = window.setTimeout(next, HOLD_MS);
    };
    timer = window.setTimeout(next, HOLD_MS);
  }

  function scheduleRoll(lang: LangCode) {
    const run = () => startRoll(lang);
    if ("requestIdleCallback" in window) {
      requestIdleCallback(run, { timeout: 1500 });
    } else {
      setTimeout(run, 200);
    }
  }

  document.addEventListener("astro:page-load", () => {
    scheduleRoll(getStoredLang());
  });

  document.addEventListener("astro:before-swap", () => stopCurrent?.());

  window.addEventListener("app:lang-change", (e: Event) => {
    const { lang } = (e as CustomEvent<{ lang: LangCode }>).detail;
    scheduleRoll(lang);
  });
</script>
