---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import { pageHref } from "../utils/url";
import { t } from "../utils/i18n";
import ProjectCard from "../components/sections/ProjectCard.astro";
import {
  EDITORIAL_LINK_SM_CLASSES,
  HOME_CTA_PRIMARY_CLASSES,
  HOME_CTA_SECONDARY_CLASSES,
  REVEAL_STAGGER_LIST_CLASSES,
} from "../utils/constants";
import { getFeaturedProjects } from "../utils/cvStats";
import { HOME_ROLE_KEYS } from "../utils/typewriter";
import type { ProjectEntry } from "../types/ui";
import { basics, projects } from "@cv";
const { name, lastName, email } = basics;
const featured = getFeaturedProjects(projects as ProjectEntry[]);
---

<Layout title={`${name} ${lastName} — ${t("basics.label")}`} type="profile">
  <section
    class="flex min-h-svh flex-col justify-center px-6 pb-20 pt-28 md:pb-24 md:pt-32"
    data-home-hero
  >
    <div class="home-enter mx-auto w-full max-w-5xl">
      <!-- Greeting -->
      <p
        class="home-enter__item mb-4 text-xs uppercase tracking-widest text-text-muted"
        data-i18n="ui.home.greeting"
      >
        {t("ui.home.greeting")}
      </p>

      <!-- Name -->
      <h1
        class="home-enter__item mb-4 text-5xl font-bold uppercase leading-none tracking-tight text-text-primary sm:text-7xl lg:text-8xl"
      >
        <span class="block">{name}</span>
        <span class="block font-light">{lastName}</span>
      </h1>

      <div class="home-enter__item mb-8">
        <p
          class="home-roles-still flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm uppercase tracking-widest text-text-secondary sm:text-base"
        >
          {
            HOME_ROLE_KEYS.map((key, i) => (
              <>
                {i > 0 && (
                  <span aria-hidden="true" class="text-text-muted">
                    ·
                  </span>
                )}
                <span data-i18n={key}>{t(key)}</span>
              </>
            ))
          }
        </p>
        <div
          class="home-roles-live flex flex-wrap items-baseline gap-x-5 gap-y-2"
        >
          <p class="sr-only">
            {
              HOME_ROLE_KEYS.map((key, i) => (
                <>
                  {i > 0 && ", "}
                  <span data-i18n={key} data-home-role>
                    {t(key)}
                  </span>
                </>
              ))
            }
          </p>
          <p
            class="hero-roll text-sm uppercase tracking-widest text-text-secondary sm:text-base"
            data-hero-roll
            aria-hidden="true"
          >
            <span>{t(HOME_ROLE_KEYS[0])}</span>
          </p>
          <div class="home-role-toggle">
            <Button
              id="home-role-toggle"
              variant="simple"
              size="none"
              aria-pressed="false"
              className="text-xs uppercase tracking-widest text-text-muted hover:text-text-primary"
            >
              <span data-i18n="ui.home.roles.pause" data-role-label="pause">
                {t("ui.home.roles.pause")}
              </span>
              <span
                data-i18n="ui.home.roles.play"
                data-role-label="play"
                class="hidden"
              >
                {t("ui.home.roles.play")}
              </span>
            </Button>
          </div>
        </div>
      </div>

      <!-- CTAs -->
      <div
        class="home-enter__item flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-8"
      >
        <Button
          href={pageHref("projects")}
          variant="simple"
          size="none"
          className={HOME_CTA_PRIMARY_CLASSES}
        >
          <svg
            class="h-4 w-4 shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
            ></path>
          </svg>
          <span data-i18n="ui.home.cta.work">{t("ui.home.cta.work")}</span>
        </Button>
        <Button
          href={`mailto:${email}`}
          variant="simple"
          size="none"
          className={HOME_CTA_SECONDARY_CLASSES}
        >
          <svg
            class="h-4 w-4 shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          <span data-i18n="ui.home.cta">{t("ui.home.cta")}</span>
        </Button>
      </div>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section
        class="mx-auto max-w-5xl px-6 pb-24 pt-16 md:pt-24"
        aria-labelledby="home-selected-heading"
      >
        <div class="reveal mb-8 flex items-baseline justify-between gap-6 border-t border-border-primary pt-8">
          <h2
            id="home-selected-heading"
            class="text-xs uppercase tracking-widest text-text-muted"
            data-i18n="ui.home.selected"
          >
            {t("ui.home.selected")}
          </h2>
          <Button
            href={pageHref("projects")}
            variant="simple"
            size="none"
            className={`group ${EDITORIAL_LINK_SM_CLASSES} gap-1.5`}
          >
            <span data-i18n="ui.home.allProjects">
              {t("ui.home.allProjects")}
            </span>
            <span class="arrow-nudge" aria-hidden="true">
              →
            </span>
          </Button>
        </div>
        <ul
          class={`${REVEAL_STAGGER_LIST_CLASSES} grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3`}
        >
          {featured.map(({ project, index, slug }, i) => (
            <li class:list={[i === 2 && "sm:max-lg:hidden"]}>
              <ProjectCard
                {project}
                projectIndex={index}
                {slug}
                sizes="(min-width: 1024px) 299px, (min-width: 640px) calc(50vw - 3rem), calc(100vw - 3rem)"
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>

<script>
  import { pageScopedController } from "../utils/motion";

  const ROLL_MS = 1100;
  const ROLL_EASING = "cubic-bezier(0.45, 0, 0.2, 1)";
  const HOLD_MS = 4000;

  document.addEventListener("astro:page-load", () => {
    const slot = document.querySelector<HTMLElement>("[data-hero-roll]");
    const toggle =
      document.querySelector<HTMLButtonElement>("#home-role-toggle");
    if (!slot || !toggle) return;

    const hero = slot.closest("[data-home-hero]");
    const { signal } = pageScopedController();
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let timer = 0;
    let index = 0;
    let paused = false;
    let rollId = 0;

    const readPhrases = () =>
      [...document.querySelectorAll<HTMLElement>("[data-home-role]")]
        .map((el) => el.textContent?.trim() ?? "")
        .filter(Boolean);

    let phrases = readPhrases();

    const stop = () => {
      window.clearTimeout(timer);
      timer = 0;
    };

    signal.addEventListener("abort", stop);

    const word = (text: string) => {
      const span = document.createElement("span");
      span.textContent = text;
      return span;
    };

    const settle = (text: string) => {
      rollId += 1;
      slot.replaceChildren(word(text));
    };

    const schedule = () => {
      stop();
      if (paused || motion.matches || phrases.length < 2) return;
      timer = window.setTimeout(() => {
        index = (index + 1) % phrases.length;
        rollTo(phrases[index] ?? "");
      }, HOLD_MS);
    };

    const rollTo = (text: string) => {
      const id = ++rollId;
      const current = slot.querySelector("span");
      const incoming = word(text);
      const travel = slot.clientHeight || 24;
      if (!current) {
        settle(text);
        schedule();
        return;
      }
      incoming.style.backgroundSize = "0% 1px";
      slot.append(incoming);
      const options: KeyframeAnimationOptions = {
        duration: ROLL_MS,
        easing: ROLL_EASING,
        fill: "forwards",
      };
      current.animate(
        [
          { transform: "translateY(0)" },
          { transform: `translateY(-${travel}px)` },
        ],
        options,
      );
      incoming
        .animate(
          [
            { transform: `translateY(${travel}px)`, backgroundSize: "0% 1px" },
            { transform: "translateY(0)", backgroundSize: "100% 1px" },
          ],
          options,
        )
        .finished.then(
          () => {
            if (id !== rollId) return;
            slot.replaceChildren(word(text));
            schedule();
          },
          () => {
            if (id !== rollId) return;
            slot.replaceChildren(word(text));
            schedule();
          },
        );
    };

    const syncLabels = () => {
      toggle.setAttribute("aria-pressed", paused ? "true" : "false");
      toggle
        .querySelector("[data-role-label='pause']")
        ?.classList.toggle("hidden", paused);
      toggle
        .querySelector("[data-role-label='play']")
        ?.classList.toggle("hidden", !paused);
    };

    const refresh = () => {
      phrases = readPhrases();
      index = Math.min(index, Math.max(phrases.length - 1, 0));
      const text = phrases[index];
      if (text) settle(text);
      schedule();
    };

    toggle.addEventListener(
      "click",
      () => {
        paused = !paused;
        syncLabels();
        if (paused) stop();
        else schedule();
      },
      { signal },
    );

    window.addEventListener("app:lang-change", refresh, { signal });

    motion.addEventListener(
      "change",
      () => {
        if (motion.matches) {
          stop();
          hero?.classList.remove("is-rolling");
          return;
        }
        hero?.classList.add("is-rolling");
        schedule();
      },
      { signal },
    );

    if (motion.matches || phrases.length === 0) return;
    hero?.classList.add("is-rolling");
    schedule();
  });
</script>

<style>
  .home-enter__item {
    opacity: 0;
    transform: translateY(10px);
    animation: home-enter 0.55s ease forwards;
  }

  .home-enter__item:nth-child(1) {
    animation-delay: 0.04s;
  }
  .home-enter__item:nth-child(2) {
    animation-delay: 0.1s;
  }
  .home-enter__item:nth-child(3) {
    animation-delay: 0.16s;
  }
  .home-enter__item:nth-child(4) {
    animation-delay: 0.22s;
  }
  @keyframes home-enter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .home-roles-still,
  .home-role-toggle {
    display: none;
  }

  .is-rolling .home-role-toggle {
    display: inline-flex;
  }

  .hero-roll {
    display: inline-grid;
    height: 1.6em;
    overflow: hidden;
    line-height: 1.4;
  }

  .hero-roll > :global(span) {
    grid-area: 1 / 1;
    align-self: start;
    white-space: nowrap;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: 100% 1px;
    padding-bottom: 0.12em;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-enter__item {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .home-roles-live {
      display: none;
    }

    .home-roles-still {
      display: flex;
    }
  }
</style>
