---
import Layout from "../layouts/Layout.astro";
import {
  PAGE_CONTAINER_CLASSES,
  PAGE_HEADING_CLASSES,
  PAGE_HEADING_MARGIN_CLASSES,
  PROJECTS_CATEGORY_HEADING_CLASSES,
  REVEAL_STAGGER_LIST_CLASSES,
  SCROLL_ANCHOR_MARGIN_CLASSES,
  LIVE_URL,
} from "../utils/constants";
import { pageHref } from "../utils/url";
import { t } from "../utils/i18n";
import { getPageTitleFromKey } from "../utils/seo";
import { projects } from "@cv";
import ProjectCard from "../components/sections/ProjectCard.astro";
import ProjectCategoryFilter from "../components/sections/ProjectCategoryFilter.astro";
import SectionHeader from "../components/sections/SectionHeader.astro";
import NextUpNav from "../components/layout/NextUpNav.astro";
import type { ProjectEntry } from "../types/ui";
import type { I18nKey } from "../i18n/en";
import { getProjectEntries, PROJECT_CATEGORY_ORDER } from "../utils/projects";

type Category = (typeof PROJECT_CATEGORY_ORDER)[number];

const CATEGORY_ORDER = PROJECT_CATEGORY_ORDER;

const CATEGORY_I18N: Record<Category, I18nKey> = {
  professional: "ui.projects.category.professional",
  personal: "ui.projects.category.personal",
  academic: "ui.projects.category.academic",
};

const indexed = getProjectEntries(projects as ProjectEntry[]);

const grouped: Record<Category, typeof indexed> = {
  professional: indexed.filter(
    ({ project }) => project.category === "professional",
  ),
  personal: indexed.filter(({ project }) => project.category === "personal"),
  academic: indexed.filter(({ project }) => project.category === "academic"),
};

const firstVisibleProjectIndex = CATEGORY_ORDER.flatMap(
  (cat) => grouped[cat],
).find(Boolean)?.index;

const firstCategory = CATEGORY_ORDER.find((cat) => grouped[cat].length > 0);

const visibleCategories = CATEGORY_ORDER.filter(
  (cat) => grouped[cat].length > 0,
);

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: t("ui.meta.projects.listName"),
  description: t("ui.meta.projects.description"),
  url: `${LIVE_URL}/projects`,
  itemListElement: indexed.map(({ project, slug, index }, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: project.name,
    description: t(
      `projects.${index}.description` as I18nKey,
      project.description,
    ),
    url: `${LIVE_URL}/projects/${slug}`,
  })),
};
---

<Layout
  title={getPageTitleFromKey("ui.page.projects")}
  description={t("ui.meta.projects.description")}
  mainTransition="none"
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(itemListSchema)}
  />
  <div class={PAGE_CONTAINER_CLASSES}>
    <h1
      class={`${PAGE_HEADING_CLASSES} ${PAGE_HEADING_MARGIN_CLASSES}`}
      data-i18n="ui.page.projects"
    >
      {t("ui.page.projects")}
    </h1>
    {
      visibleCategories.length > 1 && (
        <ProjectCategoryFilter categories={visibleCategories} />
      )
    }
    {
      CATEGORY_ORDER.map(
        (cat) =>
          grouped[cat].length > 0 && (
            <section
              data-project-category={cat}
              class:list={[
                "reveal",
                SCROLL_ANCHOR_MARGIN_CLASSES,
                cat !== firstCategory && "mt-12 md:mt-16",
              ]}
              aria-labelledby={`projects-category-${cat}`}
            >
              <SectionHeader
                titleKey={CATEGORY_I18N[cat]}
                id={`projects-category-${cat}`}
                headingClasses={PROJECTS_CATEGORY_HEADING_CLASSES}
              />
              <ul
                class={`${REVEAL_STAGGER_LIST_CLASSES} space-y-0 [&>li:first-child>article]:border-t-0`}
              >
                {grouped[cat].map(({ project, index, slug }) => (
                  <li>
                    <ProjectCard
                      {project}
                      projectIndex={index}
                      {slug}
                      priority={index === firstVisibleProjectIndex}
                    />
                  </li>
                ))}
              </ul>
            </section>
          ),
      )
    }

    <NextUpNav
      links={[
        { href: pageHref("experience"), labelKey: "ui.nextup.experience" },
        { href: pageHref("contact"), labelKey: "ui.nextup.contact" },
      ]}
    />
  </div>
</Layout>
